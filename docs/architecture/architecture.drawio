rokeWidth=3;dashed=0;strokeColor=#6a1b9a;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ml" target="acr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;MQTT + TLS&lt;/b&gt;&lt;br&gt;device key / SAS" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="236" y="230" width="140" height="40" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;Trigger&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="740" y="245" width="150" height="28" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;HTTPS POST /api/sensor-data&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1015" y="408" width="330" height="28" as="geometry"/></mxCell><mxCell id="l4a" value="&lt;b&gt;HTTPS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="236" y="566" width="180" height="28" as="geometry"/></mxCell><mxCell id="l4b" value="&lt;b&gt;HTTPS origin&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="624" y="566" width="132" height="28" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;POST /predict&lt;/b&gt;&lt;br&gt;JSON" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="962" y="590" width="116" height="44" as="geometry"/></mxCell><mxCell id="l6" value="&lt;b&gt;Read / write&lt;/b&gt; (private, TLS)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="930" y="758" width="420" height="28" as="geometry"/></mxCell><mxCell id="l7" value="&lt;b&gt;Poll queued jobs&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1000" y="832" width="360" height="30" as="geometry"/></mxCell><mxCell id="l8" value="&lt;b&gt;Live events&lt;/b&gt; (outbound HTTPS)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1775" y="505" width="280" height="30" as="geometry"/></mxCell><mxCell id="l9" value="&lt;b&gt;Alert jobs&lt;/b&gt; (outbound HTTPS)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1775" y="898" width="280" height="30" as="geometry"/></mxCell><mxCell id="l10" value="&lt;b&gt;Secrets and files via private endpoints&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="850" y="987" width="340" height="24" as="geometry"/></mxCell><mxCell id="l10a" value="&lt;b&gt;Private Link&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="848" y="1296" width="150" height="28" as="geometry"/></mxCell><mxCell id="l10b" value="&lt;b&gt;Private Link&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1088" y="1296" width="150" height="28" as="geometry"/></mxCell><mxCell id="l11" value="&lt;b&gt;Logs, metrics, traces&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1360" y="1296" width="300" height="28" as="geometry"/></mxCell><mxCell id="l12" value="&lt;b&gt;Push image&lt;/b&gt;&lt;br&gt;+ deploy (OIDC)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1968" y="1396" width="168" height="40" as="geometry"/></mxCell><mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="391" y="266" width="28" height="28" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="796" y="266" width="28" height="28" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="986" y="408" width="28" height="28" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="311" y="590" width="28" height="28" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1006" y="626" width="28" height="28" as="geometry"/></mxCell><mxCell id="b6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="886" y="736" width="28" height="28" as="geometry"/></mxCell><mxCell id="b7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1086" y="856" width="28" height="28" as="geometry"/></mxCell><mxCell id="b8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1686" y="531" width="28" height="28" as="geometry"/></mxCell><mxCell id="b9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1686" y="926" width="28" height="28" as="geometry"/></mxCell><mxCell id="b10" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7a7a7a;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="816" y="991" width="28" height="28" as="geometry"/></mxCell><mxCell id="b11" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7a7a7a;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1326" y="1298" width="28" height="28" as="geometry"/></mxCell><mxCell id="b12" value="12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2036" y="1456" width="28" height="28" as="geometry"/></mxCell><mxCell id="b13" value="13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6a1b9a;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1716" y="1456" width="28" height="28" as="geometry"/></mxCell><mxCell id="lgz" value="How to read this diagram" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#fffdf5;strokeColor=#b0a060;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="1680" width="1680" height="290" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;b&gt;1&lt;/b&gt;  ESP32 (or a Python device simulator for the lab) publishes readings to IoT Hub over MQTT with TLS. The real ESP32 firmware needs an IoT Hub identity (SAS or X.509) first.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;  An Azure Function fires on every IoT Hub message.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;  The Function POSTs the reading to /api/sensor-data on laravel-web, with the API key.&lt;br&gt;&lt;b&gt;4&lt;/b&gt;  The browser reaches laravel-web over HTTPS, optionally through Front Door Standard. Managed WAF rules need Premium (about $330/month).&lt;br&gt;&lt;b&gt;5&lt;/b&gt;  Laravel calls flask-ml on the internal ingress and gets the KNN prediction back.&lt;br&gt;&lt;b&gt;6&lt;/b&gt;  Laravel reads and writes MySQL inside the VNet (TLS, no public endpoint). Needs a privatelink.mysql.database.azure.com zone linked to the VNet.&lt;br&gt;&lt;b&gt;7&lt;/b&gt;  The worker polls the queue table in MySQL and runs the alert jobs. schedule:run and migrate run as Container Apps Jobs, not inside the worker." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="395" y="1715" width="820" height="245" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;b&gt;8&lt;/b&gt;  Laravel broadcasts live events to Pusher, which pushes them to the browser over WebSocket.&lt;br&gt;&lt;b&gt;9&lt;/b&gt;  The worker sends Ready / Nearly Ready alerts to Telegram. Optional: a NAT Gateway gives a fixed egress IP.&lt;br&gt;&lt;b&gt;10&lt;/b&gt;  Apps reach Key Vault and private Storage only via private endpoints and private DNS. Terraform writes secrets and shares through ARM (azapi), as private data planes return 403 outside the VNet.&lt;br&gt;&lt;b&gt;11&lt;/b&gt;  Diagnostic settings send logs, metrics and traces to Log Analytics and Application Insights.&lt;br&gt;&lt;b&gt;12&lt;/b&gt;  GitHub Actions builds images, pushes to ACR and deploys, using OIDC (details on page 2).&lt;br&gt;&lt;b&gt;13&lt;/b&gt;  Azure ML retrains the KNN model and registers it. The pipeline downloads model.pkl, scaler.pkl and model_metadata.json into ml/ and rebuilds flask-ml. Training pins scikit-learn 1.8.0 to match.&lt;br&gt;&lt;b&gt;MySQL tables:&lt;/b&gt; Users, Hives, Sensor_Log, Harvest, Inspection, Predictions, HRI_Summary (trigger).&lt;br&gt;&lt;b&gt;Stateless Laravel:&lt;/b&gt; database sessions and cache, trusted proxies on, logs to stderr. Hive images sit on container disk, so the lab runs one web replica.&lt;br&gt;&lt;b&gt;Lab cost:&lt;/b&gt; $135.68 credit left. About $50-70/month if left running, so one day costs a few dollars. Destroy after the session." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1230" y="1715" width="820" height="245" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 Governance and DevOps"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1400" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Azure Infrastructure Architecture: Hive Harvest Readiness Monitoring (page 2 of 2: governance, identity, DevOps, operations)" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1600" height="44" as="geometry"/></mxCell><mxCell id="gov" value="Governance (subscription scope)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#fff5f4;strokeColor=#b85450;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=50;spacingTop=10;fontSize=16;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1800" height="270" as="geometry"/></mxCell><mxCell id="govi" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="1"><mxGeometry x="52" y="116" width="32" height="32" as="geometry"/></mxCell><mxCell id="g1" value="Subscription&lt;br&gt;(free account, $135.68 credit left)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;dashed=0;verticalAlign=bottom;spacingBottom=8;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="200" height="170" as="geometry"/></mxCell><mxCell id="g1i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="g1"><mxGeometry x="68" y="12" width="64" height="64" as="geometry"/></mxCell><mxCell id="g2" value="Azure Policy&lt;br&gt;allowed regions, required tags (audit mode)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;dashed=0;verticalAlign=bottom;spacingBottom=8;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="360" y="170" width="200" height="170" as="geometry"/></mxCell><mxCell id="g2i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="g2"><mxGeometry x="68" y="12" width="64" height="64" as="geometry"/></mxCell><mxCell id="g3" value="Resource locks&lt;br&gt;CanNotDelete, toggle variable (off in lab so destroy works)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;dashed=0;verticalAlign=bottom;spacingBottom=8;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="200" height="170" as="geometry"/></mxCell><mxCell id="g3i" value="🔒" style="text;html=1;fontSize=44;align=center;verticalAlign=middle;" vertex="1" parent="g3"><mxGeometry x="50" y="10" width="100" height="70" as="geometry"/></mxCell><mxCell id="g4" value="Tags&lt;br&gt;env=lab, project=hive" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;dashed=0;verticalAlign=bottom;spacingBottom=8;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="170" width="200" height="170" as="geometry"/></mxCell><mxCell id="g4i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/general/Tags.svg;" vertex="1" parent="g4"><mxGeometry x="68" y="12" width="64" height="64" as="geometry"/></mxCell><mxCell id="g5" value="Budget alerts&lt;br&gt;75% and 90% of $100 (notify only, no stop)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;dashed=0;verticalAlign=bottom;spacingBottom=8;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="200" height="170" as="geometry"/></mxCell><mxCell id="g5i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/general/Cost_Management_and_Billing.svg;" vertex="1" parent="g5"><mxGeometry x="68" y="12" width="64" height="64" as="geometry"/></mxCell><mxCell id="g6" value="Defender for Cloud&lt;br&gt;free posture tier" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;dashed=0;verticalAlign=bottom;spacingBottom=8;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="1520" y="170" width="200" height="170" as="geometry"/></mxCell><mxCell id="g6i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/security/Security_Center.svg;" vertex="1" parent="g6"><mxGeometry x="68" y="12" width="64" height="64" as="geometry"/></mxCell><mxCell id="idz" value="Identity and access (Microsoft Entra ID)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f3f9ff;strokeColor=#0078D4;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=50;spacingTop=10;fontSize=15;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="520" height="460" as="geometry"/></mxCell><mxCell id="idzi" value="" style="image;aspect=fixed;html=1;points=[];align